
{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"demo.User",
  "type":"object",
  "properties":{
    "name":{
      "type":"string"
    },
    "age":{
      "type":"integer"
    },
    "gender":{
      "type":"boolean"
    },
    "$schema": true
  },
  "required":[
    "name",
    "age",
    "gender"
  ],
  "additionalProperties":false
}