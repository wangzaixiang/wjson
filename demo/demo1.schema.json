{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"demo.Cube",
  "type":"object",
  "properties":{
    "name":{
      "type":"string"
    },
    "views":{
      "type":"array",
      "items":{
        "$ref":"#/definitions/demo.View"
      },
      "description":"source views"
    },
    "dimensions":{
      "type":"array",
      "items":{
        "$ref":"#/definitions/demo.Dimension"
      },
      "description":"olap dimensions"
    },
    "measures":{
      "type":"array",
      "items":{
        "$ref":"#/definitions/demo.Measure"
      },
      "description":"olap measures"
    },
    "viewName":{
      "type":"string"
    }
  },
  "required":[
    "views",
    "dimensions",
    "measures",
    "viewName"
  ],
  "additionalProperties":false,
  "definitions":{
    "demo.Measure":{
      "type":"object",
      "properties":{
        "name":{
          "type":"string"
        },
        "column":{
          "type":"string",
          "$comment":"pointer to demo.Column"
        },
        "aggregator":{
          "$ref":"#/definitions/demo.Aggregator"
        }
      },
      "required":[
        "name",
        "column",
        "aggregator"
      ],
      "additionalProperties":false
    },
    "demo.Aggregator":{
      "oneOf":[
        {
          "const":"SUM"
        },
        {
          "const":"AVG"
        },
        {
          "const":"MAX"
        },
        {
          "const":"MIN"
        },
        {
          "const":"COUNT"
        },
        {
          "const":"COUNT_DISTINCT"
        }
      ]
    },
    "demo.View":{
      "type":"object",
      "properties":{
        "name":{
          "type":"string"
        },
        "columns":{
          "type":"array",
          "items":{
            "$ref":"#/definitions/demo.Column"
          }
        }
      },
      "required":[
        "name",
        "columns"
      ],
      "additionalProperties":false
    },
    "demo.Column":{
      "type":"object",
      "properties":{
        "name":{
          "type":"string"
        },
        "columnDef":{
          "$ref":"#/definitions/demo.ColumnDef"
        }
      },
      "required":[
        "name",
        "columnDef"
      ],
      "additionalProperties":false
    },
    "demo.ColumnDef":{
      "oneOf":[
        {
          "type":"object",
          "additionalProperties":false,
          "properties":{
            "name":{
              "type":"string"
            },
            "_$tag":{
              "const":"OriginalColumn"
            }
          },
          "required":[
            "name",
            "_$tag"
          ]
        },
        {
          "type":"object",
          "additionalProperties":false,
          "properties":{
            "expr":{
              "type":"string"
            },
            "_$tag":{
              "const":"CalcColumn"
            }
          },
          "required":[
            "expr",
            "_$tag"
          ]
        },
        {
          "const":"RangeColumn"
        }
      ]
    },
    "demo.Dimension":{
      "type":"object",
      "properties":{
        "name":{
          "type":"string",
          "description":"dimension name"
        },
        "column":{
          "type":"string",
          "$comment":"pointer to demo.Column"
        }
      },
      "required":[
        "name",
        "column"
      ],
      "additionalProperties":false
    }
  }
}
